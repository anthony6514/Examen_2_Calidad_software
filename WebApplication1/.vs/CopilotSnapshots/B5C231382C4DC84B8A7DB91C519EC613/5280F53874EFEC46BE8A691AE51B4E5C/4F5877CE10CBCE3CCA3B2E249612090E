@model WebApplication1.Models.Product
@{
    ViewData["Title"] = Model?.Title ?? "Producto";
}

<div class="container my-4">
    <div class="row">
        <div class="col-md-5 text-center">
            <img src="@Model.Image" class="img-fluid product-img" alt="@Model.Title" style="height:300px;" />
        </div>
        <div class="col-md-7">
            <h2>@Model.Title</h2>
            <p class="text-muted">@Model.Category</p>
            <p>@Model.Description</p>
            <h4 class="mt-3">@Model.Price.ToString("C")</h4>
            @if (Model.Rating != null)
            {
                <p class="text-muted">Rating: @Model.Rating.Rate (@Model.Rating.Count)</p>
            }
            <a class="btn btn-primary mt-3" href="/Product">Volver</a>
        </div>
    </div>
</div>
