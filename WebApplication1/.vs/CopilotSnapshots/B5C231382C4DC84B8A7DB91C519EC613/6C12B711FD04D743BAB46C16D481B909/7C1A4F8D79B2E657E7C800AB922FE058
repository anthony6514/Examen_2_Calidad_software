@model List<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Productos";
}

<div class="container">
    <h1 class="text-center my-4">Lista de Productos</h1>

    @if (Model == null || !Model.Any())
    {
        <p class="text-center">No hay productos para mostrar.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 product-card">
                        <img src="@product.Image" class="card-img-top product-img" alt="@product.Title" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Title</h5>
                            <p class="card-text text-truncate">@product.Description</p>
                            <div class="mt-auto">
                                <p class="fw-bold mb-1">@product.Price.ToString("C")</p>
                                <p class="text-muted small mb-2">Stock: @(product.Rating?.Count ?? 0)</p>
                                <a class="btn btn-primary btn-sm" href="/Product/Details/@product.Id">Ver</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
