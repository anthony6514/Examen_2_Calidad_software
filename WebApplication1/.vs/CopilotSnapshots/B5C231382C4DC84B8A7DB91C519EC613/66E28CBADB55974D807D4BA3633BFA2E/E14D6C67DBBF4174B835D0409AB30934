@model List<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid text-center">
    <h1>Lista de Productos</h1>
    <div class="d-flex flex-wrap justify-content-center">


    @if (Model == null || !Model.Any())
    {
        <p>No hay productos para mostrar.</p>
    }
    else
    {
        <div class="d-flex flex-wrap justify-content-start gap-3">
            @foreach (var item in Model)
            {
                <div class="card" style="width: 18rem;">
                    <img src="@item.Image" class="card-img-top" alt="@item.Title" />
                    <div class="card-body text-start">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-truncate" style="max-height:3.6rem; overflow:hidden;">@item.Description</p>
                        <p class="card-text"><strong>@item.Price.ToString("C")</strong></p>
                        <p class="card-text">Stock: @(item.Rating?.Count ?? 0)</p>
                        <a class="btn btn-sm btn-primary" href="/Product/Details/@item.Id">Ver</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
