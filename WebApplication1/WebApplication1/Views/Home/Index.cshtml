@model List<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid text-center">
    <h1>Lista de Productos</h1>

    <div class="d-flex flex-wrap justify-content-center gap-5">
        @foreach (var product in Model)
        {
            <div class="card product-card" style="width: 18rem;">
                <img src="@product.Image" class="card-img-top img-fluid p-3 product-img d-block mx-auto" alt="@product.Title" style="height: 200px;" />
                <div class="card-body d-flex flex-column justify-content-between text-center">
                    <h5 class="card-title">@product.Title</h5>
                    <p class="card-text text-truncate">@product.Description</p>
                    <h5>@product.Price.ToString("C")</h5>
                    <a href="/Product/Details/@product.Id" class="btn btn-primary btn-full">Ver Detalles</a>
                </div>
            </div>
        }
    </div>
</div>
