@model ProyectoExamenApi.Models.YuGiOhPageViewModel
@{
    ViewData["Title"] = "Cartas Blue-Eyes";
}

<div class="text-center mb-4">
    <h1>Cartas relacionadas con Blue-Eyes</h1>
    <p class="lead">Catálogo de cartas del arquetipo Dragon Blanco de Ojos Azules.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.Cards.Count == 0)
{
    <div class="alert alert-info">No se encontraron cartas para mostrar.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var card in Model.Cards)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@card.MainImage" class="card-img-top p-2" alt="@card.Name" style="height: 330px; object-fit: contain;" />
                    <div class="card-body d-flex flex-column">
                        <h2 class="card-title h5">@card.Name</h2>
                        <p class="card-text text-muted">@card.Type</p>
                        <p class="card-text fw-bold mt-auto">Precio: @(card.MainPrice?.Tcgplayer ?? "No disponible")</p>
                        <a class="btn btn-primary" asp-controller="Card" asp-action="Details" asp-route-id="@card.Id">Ver detalles</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="mt-4" aria-label="Paginación de cartas">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Anterior</a>
            </li>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
